# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Slack incoming webhook for alert notifications (leave blank to log to console/dashboard only)
SLACK_WEBHOOK_URL=

# Alert thresholds
LATENCY_ALERT_MS=15000
MAX_TOOL_ITERATIONS=6
COST_ALERT_USD=0.50

# Canary promotion tolerances
CANARY_MIN_SUCCESS_RATE=0.85
CANARY_MAX_LATENCY_REGRESSION=1.25

# Arize Phoenix local tracing UI port
PHOENIX_PORT=6006
